<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:FloodFillAvalonia"
        x:Class="FloodFillAvalonia.MainWindow"
        Width="1280" Height="820"
        MinWidth="1050" MinHeight="700"
        Title="Задание 1 — заливка и выделение границы">
  <Grid RowDefinitions="Auto,*,Auto" ColumnDefinitions="260,*" Margin="12">
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#1E293B" CornerRadius="10" Padding="14" Margin="0,0,0,10">
      <Grid ColumnDefinitions="Auto,*">
        <StackPanel>
          <TextBlock Text="Заливка и выделение границы" FontSize="22" FontWeight="Bold" />
          <TextBlock Text="Рекурсивные алгоритмы на основе серий пикселей" Opacity="0.75" />
        </StackPanel>
        <TextBlock Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                   x:Name="ModeText" Text="Режим: 1а — цвет" FontSize="16" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Grid.Column="0" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,10,0">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="10">
          <TextBlock Text="Режим работы" FontWeight="Bold" FontSize="16" />
          <Button x:Name="ModeColorButton" Content="1а. Заливка цветом" Click="ModeColor_Click" HorizontalContentAlignment="Left" />
          <Button x:Name="ModePatternButton" Content="1б. Заливка рисунком" Click="ModePattern_Click" HorizontalContentAlignment="Left" />
          <Button x:Name="ModeBoundaryButton" Content="1в. Обход границы" Click="ModeBoundary_Click" HorizontalContentAlignment="Left" />

          <Separator />
          <TextBlock Text="Инструмент рисования" FontWeight="Bold" />
          <TextBlock Text="Нарисуйте замкнутый контур левой кнопкой мыши. Для заливки после выбора режима щёлкните внутри области." TextWrapping="Wrap" Opacity="0.75" />

          <TextBlock Text="Допуск цвета" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="ColorToleranceBox" Text="10" Watermark="0–64" />
            <Button Grid.Column="1" Content="Применить" Click="ApplyTolerance_Click" />
          </Grid>
          <TextBlock Text="Небольшое отличие RGB считается одинаковым цветом. По умолчанию ±10 на каждый канал — полезно для сглаженных/сжатых изображений." TextWrapping="Wrap" Opacity="0.75" />

          <TextBlock Text="Цвет заливки" FontWeight="Bold" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
            <TextBox x:Name="ColorHexBox" Text="#2DD4BF" Watermark="#RRGGBB" />
            <Button Grid.Column="1" Content="Применить" Click="ApplyColor_Click" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Button Content="Красный" Click="PresetRed_Click" />
            <Button Content="Синий" Click="PresetBlue_Click" />
            <Button Content="Зелёный" Click="PresetGreen_Click" />
          </StackPanel>

          <Separator />
          <TextBlock Text="Рисунок для 1б" FontWeight="Bold" />
          <Button Content="Загрузить изображение…" Click="LoadPattern_Click" />
          <TextBlock x:Name="PatternInfo" Text="Файл не выбран" TextWrapping="Wrap" Opacity="0.8" />
          <CheckBox x:Name="PatternRepeatBox" Content="Циклически повторять маленький рисунок" IsChecked="True" />

          <Separator />
          <TextBlock Text="Граница для 1в" FontWeight="Bold" />
          <TextBlock Text="Цвет границы берётся из пикселя под курсором. Можно щёлкнуть по любому пикселю этой связной границы; для толстой линии будет найден её внешний контур." TextWrapping="Wrap" Opacity="0.75" />
          <Button Content="Загрузить исходное изображение…" Click="LoadImage_Click" />
          <Button Content="Снять выделение границы" Click="ClearBoundary_Click" />
          <TextBlock x:Name="BoundaryInfo" Text="Точек обхода: 0" />

          <Separator />
          <Button Content="Очистить холст" Click="Clear_Click" />
          <Button Content="Сохранить результат…" Click="Save_Click" />
        </StackPanel>
      </ScrollViewer>
    </Border>

    <Border Grid.Row="1" Grid.Column="1" BorderBrush="#334155" BorderThickness="1" CornerRadius="8" Background="#0F172A" Padding="8">
      <local:PixelCanvas x:Name="Canvas" />
    </Border>

    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#E2E8F0" CornerRadius="8" Padding="10" Margin="0,10,0,0">
      <TextBlock x:Name="StatusText" Text="Готово. Нарисуйте контур мышкой." Foreground="#0F172A" />
    </Border>
  </Grid>
</Window>
